<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.driveguard.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#88000000"
        android:padding="6dp"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:id="@+id/thresholdsPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/safeHeadwayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safe Headway: 2.0s"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/safeHeadwaySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:min="5"
            android:progress="20" />

        <TextView
            android:id="@+id/critHeadwayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Critical Headway: 1.0s"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/critHeadwaySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:min="2"
            android:progress="10" />

        <TextView
            android:id="@+id/critTtcLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Critical TTC: 2.5s"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/critTtcSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:min="5"
            android:progress="25" />
    </LinearLayout>
</FrameLayout>
